# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional MongoDB connection string (Atlas or local).
# If omitted, PatternForge DSA automatically runs with in-memory + browser persistence.
# Set this in your Secrets / .env to enable persistent MongoDB storage:
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/patternforge-dsa?retryWrites=true&w=majority"


# Supabase Auth (public values are exposed to the browser through Vite)
# Production post-OAuth destination. For local development, leave unset so the
# frontend uses window.location.origin.
VITE_AUTH_REDIRECT_URL="https://tutorial-hub-f5ck.onrender.com"
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Server-side token verification. Use the SAME Supabase project as VITE_SUPABASE_URL.
# SUPABASE_URL may be omitted because the backend falls back to VITE_SUPABASE_URL.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# Preferred server key. Never expose this value through a VITE_ variable or commit a real key.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
# Optional fallback for token verification if a service-role key is not configured.
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
