# Google OAuth / Supabase Auth (public values are embedded into the frontend build)
# Use the same Supabase project for both frontend and backend.
# OAuth post-login redirect uses the current browser origin (local or Render).
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Server-side verification for /api/auth/me.
# This must be from the SAME Supabase project as VITE_SUPABASE_URL.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# Use the SAME project's anon key for server-side getUser verification.
# This key is public and may be the same value as VITE_SUPABASE_ANON_KEY.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
# Optional service-role fallback (same project only; keep server-only).
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# MongoDB persistence for user accounts and learning profiles.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/patternforge-dsa?retryWrites=true&w=majority"

# Protect server-side interview problem catalog POST/PATCH endpoints. Never expose this token to VITE_*.
PROBLEM_CATALOG_ADMIN_TOKEN="replace-with-a-long-random-server-only-token"

# Comma-separated Supabase user UUIDs authorized to use the authoring workspace.
# Leave unset to keep authoring APIs disabled (fail closed).
CONTENT_AUTHOR_USER_IDS="00000000-0000-0000-0000-000000000000"
