    "@supabase/supabase-js": "^2.57.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^13.0.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mermaid": "^12.3.0",
    "mongoose": "^9.12.2",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "ws": "^8.23.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
