    "audit:learning-surfaces": "node scripts/validate-learning-surface-registry.mjs",
    "test:dsa:inventory": "node --import tsx tests/dsa/master-interview-inventory.test.mjs",
    "test:dsa:handwritten": "node --import tsx --test tests/dsa/handwritten-notes-curriculum.test.mjs",
    "test:dsa:completeness-pilot": "node --import tsx --test tests/dsa/topic-completeness-pilot.test.mjs",
    "test:content-bootstrap-security": "node --import tsx --test tests/content-bootstrap-security.test.mjs",
    "test:system-design-ai-security": "node --import tsx --test tests/system-design-ai-security.test.mjs",
    "test:solver-endpoint-security": "node --import tsx --test tests/solver-endpoint-security.test.mjs",
    "audit:learning-content": "node scripts/validate-learning-content-quality-audit.mjs",
    "audit:topic-inventory": "node scripts/audit-topic-content-inventory.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
